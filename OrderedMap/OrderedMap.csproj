<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- The assembly, not the namespace: `OrderedMap.OrderedMap<TK, TV>` is
             unaffected. Assembly names are matched without regard to case, so
             this and the `(std orderedmap)` module's own `orderedmap.dll` would
             otherwise be one name to the loader. -->
        <AssemblyName>BjoOrderedMap</AssemblyName>
    </PropertyGroup>

</Project>
